# Copy to .env and edit. Never commit .env.

# A long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
KALISI_JWT_SECRET=replace-with-a-long-random-string
KALISI_DB_PASSWORD=kalisi

# dev  = OTP codes shown on screen; demo phone numbers starting 00 allowed.
# prod = codes must go by SMS (no SMS provider is wired in yet, so sign-in will refuse until one is).
KALISI_ENV=dev
KALISI_CORS_ORIGINS=http://localhost:8000

# Optional: a self-hosted OSRM server for road travel times in the planner, e.g. http://osrm:5000
KALISI_OSRM_URL=
